        "messages": {
          "values": [
            {
              "content": "=You are an expert influencer marketing analyst.\n\nAnalyze the following Instagram influencer for a fashion brand collaboration.\n\nINFLUENCER DETAILS:\n\nName: {{ $json.name }}\nUsername: {{ $json.username }}\nNiche: {{ $json.niche }}\nFollowers: {{ $json.followers }}\nLocation: {{ $json.location }}\n\nTASK:\n\n1. Write a short profile summary.\n2. Evaluate relevance to a fashion brand.\n3. Evaluate follower count suitability.\n4. Give a suitability score out of 100.\n5. Recommend whether the brand should collaborate.\n6. Explain your decision.\n\nReturn the result in a clear, structured format.\n\nDo not invent information that is not provided.\nIMPORTANT:\nNever assume engagement rates, audience demographics,\ncontent quality or audience loyalty.\n\nOnly use the information provided.\nClearly mention which information is unavailable.\nTreat the suitability score as preliminary."
            }
          ]
        },
